<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.ApplicationSettingsWindow"
             x:DataType="vm:ApplicationSettingsViewModel"
             Title="{Binding TitleText}"
             Width="620"
             Height="680"
             MinWidth="480"
             MinHeight="420"
             WindowStartupLocation="CenterOwner"
             ShowInTaskbar="False"
             Background="{atom:SharedTokenResource ColorBgLayout}">

    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
            BorderBrush="{atom:SharedTokenResource ColorBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="22">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="cx-hero-title" Text="{Binding TitleText}"/>
                    <TextBlock Classes="cx-meta" Text="{Binding GeneralText}"/>
                </StackPanel>
                <atom:Button Grid.Column="1"
                             Classes="cx-icon-button"
                             ButtonType="Text"
                             Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                             Click="OnCloseClick"
                             atom:ToolTip.Tip="{Binding CloseText}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="cx-section-title" Text="{Binding StartupText}"/>
                        <Border Classes="cx-card-quiet">
                            <atom:CheckBox Content="{Binding ShowSessionManagerOnStartupText}"
                                           IsChecked="{Binding ShowSessionManagerOnStartup, Mode=TwoWay}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="cx-section-title" Text="{Binding AppearanceText}"/>
                        <Border Classes="cx-card-quiet">
                            <StackPanel Spacing="8">
                                <atom:CheckBox Content="{Binding ShowTabBarText}"
                                               IsChecked="{Binding ShowTabBar, Mode=TwoWay}"/>
                                <atom:CheckBox Content="{Binding EnableCommandSuggestionsText}"
                                               IsChecked="{Binding EnableCommandSuggestions, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="cx-section-title" Text="{Binding UpdatesText}"/>
                        <Border Classes="cx-card-quiet">
                            <StackPanel Spacing="8">
                                <atom:CheckBox Content="{Binding AutoCheckForUpdatesText}"
                                               IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}"/>
                                <atom:CheckBox Content="{Binding IncludePrereleaseUpdatesText}"
                                               IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="cx-section-title" Text="{Binding LanguageText}"/>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <atom:RadioButton Content="{Binding ChineseText}"
                                              GroupName="ApplicationLanguage"
                                              IsChecked="{Binding IsChineseSelected, Mode=TwoWay}"/>
                            <atom:RadioButton Content="{Binding EnglishText}"
                                              GroupName="ApplicationLanguage"
                                              IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="cx-section-title" Text="{Binding RecordingText}"/>
                        <Border Classes="cx-card-quiet">
                            <StackPanel Spacing="8">
                                <atom:CheckBox Content="{Binding RecordTerminalSessionsText}"
                                               IsChecked="{Binding RecordTerminalSessions, Mode=TwoWay}"/>
                                <TextBlock Classes="cx-section-hint" Text="{Binding RecordingDescriptionText}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="cx-field-label" Text="{Binding RecordingRetentionText}"/>
                                    <atom:NumericUpDown Width="96"
                                                        Minimum="1"
                                                        Maximum="3650"
                                                        Value="{Binding RecordingRetentionDays, Mode=TwoWay}"/>
                                    <TextBlock Classes="cx-field-label" Text="{Binding RecordingDaysText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="cx-section-title" Text="{Binding SshSecurityText}"/>
                        <Border Classes="cx-card-quiet">
                            <StackPanel Spacing="9">
                                <atom:CheckBox Content="{Binding ConfirmSshHostKeyOnFirstConnectionText}"
                                               IsChecked="{Binding ConfirmSshHostKeyOnFirstConnection, Mode=TwoWay}"/>
                                <atom:CheckBox Content="{Binding BlockChangedSshHostKeysText}"
                                               IsChecked="{Binding BlockChangedSshHostKeys, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="cx-field-label"
                                   Text="{Binding KnownHostsText}"
                                   Margin="0,4,0,0"/>
                        <Border Classes="cx-card-quiet">
                            <Grid>
                                <TextBlock Classes="cx-section-hint"
                                           Text="{Binding NoKnownHostsText}"
                                           IsVisible="{Binding !HasKnownHosts}"
                                           Margin="6,8"/>
                                <ItemsControl ItemsSource="{Binding KnownHosts}"
                                              IsVisible="{Binding HasKnownHosts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:KnownSshHostKeyItemViewModel">
                                            <Border BorderBrush="{atom:SharedTokenResource ColorSplit}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="6,7">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <atom:TextBlock Classes="cx-panel-title"
                                                                            Text="{Binding EndpointText}"/>
                                                            <TextBlock Text="{Binding KeyTypeText}"
                                                                       FontSize="11"
                                                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                                                            <TextBlock Classes="cx-meta"
                                                                       Text="{Binding LastSeenText}"/>
                                                        </StackPanel>
                                                        <TextBlock Classes="cx-mono"
                                                                   Text="{Binding FingerprintText}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <atom:Button Grid.Column="1"
                                                                 Classes="cx-icon-button"
                                                                 ButtonType="Text"
                                                                 Icon="{antdicons:AntDesignIconProvider Kind=DeleteOutlined}"
                                                                 Command="{Binding RemoveCommand}"
                                                                 atom:ToolTip.Tip="{Binding RemoveText}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <atom:Button Content="{Binding CloseText}"
                             ButtonType="Primary"
                             Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Border>
</atom:Window>
