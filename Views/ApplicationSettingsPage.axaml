<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.ApplicationSettingsPage"
             x:DataType="vm:ApplicationSettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="0,2,12,8">
            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding StartupText}"/>
                <Border Classes="cx-card-quiet">
                    <atom:CheckBox Content="{Binding ShowSessionManagerOnStartupText}"
                                   IsChecked="{Binding ShowSessionManagerOnStartup, Mode=TwoWay}"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding AppearanceText}"/>
                <Border Classes="cx-card-quiet">
                    <StackPanel Spacing="8">
                        <atom:CheckBox Content="{Binding ShowTabBarText}"
                                       IsChecked="{Binding ShowTabBar, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ShowSftpPanelText}"
                                       IsChecked="{Binding ShowSftpPanel, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ShowMonitorPanelText}"
                                       IsChecked="{Binding ShowMonitorPanel, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ShowAgentPanelText}"
                                       IsChecked="{Binding ShowAgentPanel, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding EnableCommandSuggestionsText}"
                                       IsChecked="{Binding EnableCommandSuggestions, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding ThemeText}"/>
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <atom:RadioButton Content="{Binding DarkThemeText}"
                                      GroupName="ApplicationTheme"
                                      IsChecked="{Binding IsDarkThemeSelected, Mode=TwoWay}"/>
                    <atom:RadioButton Content="{Binding LightThemeText}"
                                      GroupName="ApplicationTheme"
                                      IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding NetworkText}"/>
                <Border Classes="cx-card-quiet">
                    <StackPanel Spacing="9">
                        <TextBlock Classes="cx-section-title" Text="{Binding GlobalProxyText}"/>
                        <atom:CheckBox Content="{Binding GlobalProxyEnabledText}"
                                       IsChecked="{Binding GlobalProxyEnabled, Mode=TwoWay}"/>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Classes="cx-field-label" Text="{Binding GlobalProxyTypeText}"/>
                            <atom:Select Grid.Column="1"
                                         OptionsSource="{Binding GlobalProxyTypeOptions}"
                                         SelectedOption="{Binding GlobalProxyTypeOption, Mode=TwoWay}"
                                         HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Classes="cx-field-label" Text="{Binding GlobalProxyHostText}"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding GlobalProxyHost, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,Auto"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Classes="cx-field-label" Text="{Binding GlobalProxyPortText}"/>
                            <atom:NumericUpDown Grid.Column="1"
                                                Width="92"
                                                Minimum="0"
                                                Maximum="65535"
                                                Value="{Binding GlobalProxyPort, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Classes="cx-field-label" Text="{Binding GlobalProxyUsernameText}"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding GlobalProxyUsername, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding GlobalProxyEnabled}">
                            <TextBlock Classes="cx-field-label" Text="{Binding GlobalProxyPasswordText}"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding GlobalProxyPassword, Mode=TwoWay}"
                                          PasswordChar="*"
                                          IsEnableRevealButton="True"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding UpdatesText}"/>
                <Border Classes="cx-card-quiet">
                    <StackPanel Spacing="8">
                        <atom:CheckBox Content="{Binding AutoCheckForUpdatesText}"
                                       IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding IncludePrereleaseUpdatesText}"
                                       IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding LanguageText}"/>
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <atom:RadioButton Content="{Binding ChineseText}"
                                      GroupName="ApplicationLanguage"
                                      IsChecked="{Binding IsChineseSelected, Mode=TwoWay}"/>
                    <atom:RadioButton Content="{Binding EnglishText}"
                                      GroupName="ApplicationLanguage"
                                      IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding RecordingText}"/>
                <Border Classes="cx-card-quiet">
                    <StackPanel Spacing="8">
                        <atom:CheckBox Content="{Binding RecordTerminalSessionsText}"
                                       IsChecked="{Binding RecordTerminalSessions, Mode=TwoWay}"/>
                        <TextBlock Classes="cx-section-hint" Text="{Binding RecordingDescriptionText}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="cx-field-label" Text="{Binding RecordingRetentionText}"/>
                            <atom:NumericUpDown Width="96"
                                                Minimum="1"
                                                Maximum="3650"
                                                Value="{Binding RecordingRetentionDays, Mode=TwoWay}"/>
                            <TextBlock Classes="cx-field-label" Text="{Binding RecordingDaysText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding SshSecurityText}"/>
                <Border Classes="cx-card-quiet">
                    <StackPanel Spacing="9">
                        <atom:CheckBox Content="{Binding ConfirmSshHostKeyOnFirstConnectionText}"
                                       IsChecked="{Binding ConfirmSshHostKeyOnFirstConnection, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding BlockChangedSshHostKeysText}"
                                       IsChecked="{Binding BlockChangedSshHostKeys, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding ExternalLaunchText}"/>
                <Border Classes="cx-card-quiet">
                    <StackPanel Spacing="9">
                        <atom:CheckBox Content="{Binding AllowExternalLaunchText}"
                                       IsChecked="{Binding AllowExternalLaunch, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding ConfirmExternalLaunchText}"
                                       IsChecked="{Binding ConfirmExternalLaunch, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding RegisterExternalUrlProtocolsText}"
                                       IsChecked="{Binding RegisterExternalUrlProtocols, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="cx-field-label" Text="{Binding ExternalLaunchTrustCountText}"/>
                            <atom:Button Content="{Binding ClearTrustedExternalLaunchTargetsText}"
                                         Command="{Binding ClearTrustedExternalLaunchTargetsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
