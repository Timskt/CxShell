<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:vm="using:CxShell.ViewModels"
             x:Class="CxShell.Views.AgentSettingsPage"
             x:DataType="vm:ApplicationSettingsViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="0,2,12,8">
            <StackPanel Spacing="8">
                <TextBlock Classes="cx-section-title" Text="{Binding AgentText}"/>
                <Border Classes="cx-card-quiet">
                    <StackPanel Spacing="10">
                        <atom:CheckBox Content="{Binding AgentEnabledText}"
                                       IsChecked="{Binding AgentEnabled, Mode=TwoWay}"/>
                        <atom:CheckBox Content="{Binding AgentAllowCommandExecutionText}"
                                       IsChecked="{Binding AgentAllowCommandExecution, Mode=TwoWay}"/>
                        <Grid ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              IsEnabled="{Binding AgentAllowCommandExecution}">
                            <TextBlock Classes="cx-field-label" Text="{Binding AgentPermissionModeText}"/>
                            <atom:Select Grid.Column="1"
                                         OptionsSource="{Binding AgentPermissionModeOptions}"
                                         SelectedOption="{Binding AgentPermissionModeOption, Mode=TwoWay}"
                                         HorizontalAlignment="Stretch"/>
                        </Grid>
                        <TextBlock Classes="cx-section-hint"
                                   Text="{Binding AgentPermissionModeDescriptionText}"
                                   Margin="142,0,0,0"/>
                        <atom:CheckBox Content="{Binding AgentReadOnlyModeText}"
                                       IsChecked="{Binding AgentReadOnlyMode, Mode=TwoWay}"
                                       IsEnabled="{Binding AgentAllowCommandExecution}"/>
                        <TextBlock Classes="cx-section-hint"
                                   Text="{Binding AgentCommandPolicyDescriptionText}"/>
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="132,*"
                              ColumnSpacing="10"
                              RowSpacing="8">
                            <TextBlock Classes="cx-field-label"
                                       Text="{Binding AgentAllowedCommandPrefixesText}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,0,0"/>
                            <atom:TextBox Grid.Column="1"
                                          Text="{Binding AgentAllowedCommandPrefixes, Mode=TwoWay}"
                                          AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          MinHeight="48"
                                          PlaceholderText="pwd\nfree -m"/>
                            <TextBlock Grid.Row="1"
                                       Classes="cx-field-label"
                                       Text="{Binding AgentBlockedCommandPrefixesText}"
                                       VerticalAlignment="Top"
                                       Margin="0,6,0,0"/>
                            <atom:TextBox Grid.Row="1"
                                          Grid.Column="1"
                                          Text="{Binding AgentBlockedCommandPrefixes, Mode=TwoWay}"
                                          AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          MinHeight="48"
                                          PlaceholderText="rm\nshutdown"/>
                        </Grid>
                        <TextBlock Classes="cx-section-hint" Text="{Binding AgentDescriptionText}"/>
                        <Grid ColumnDefinitions="132,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="9">
                            <TextBlock Classes="cx-field-label" Text="{Binding AgentProviderText}"/>
                            <atom:Select Grid.Column="1"
                                         OptionsSource="{Binding AgentProviderTypeOptions}"
                                         SelectedOption="{Binding AgentProviderTypeOption, Mode=TwoWay}"
                                         HorizontalAlignment="Stretch"/>

                            <TextBlock Grid.Row="1"
                                       Classes="cx-field-label"
                                       Text="{Binding AgentProviderNameText}"/>
                            <atom:TextBox Grid.Row="1"
                                          Grid.Column="1"
                                          Text="{Binding AgentProviderName, Mode=TwoWay}"
                                          MinWidth="220"/>

                            <TextBlock Grid.Row="2"
                                       Classes="cx-field-label"
                                       Text="{Binding AgentBaseUrlText}"/>
                            <atom:TextBox Grid.Row="2"
                                          Grid.Column="1"
                                          Text="{Binding AgentBaseUrl, Mode=TwoWay}"
                                          MinWidth="220"/>

                            <TextBlock Grid.Row="3"
                                       Classes="cx-field-label"
                                       Text="{Binding AgentModelText}"/>
                            <Grid Grid.Row="3"
                                  Grid.Column="1"
                                  ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="6">
                                <atom:TextBox Text="{Binding AgentModel, Mode=TwoWay}"
                                              MinWidth="160"/>
                                <atom:Button x:Name="AgentModelPickerButton"
                                             Grid.Column="1"
                                             Content="{Binding AgentModelCatalogSummaryText}"
                                             Icon="{antdicons:AntDesignIconProvider Kind=DownOutlined}"
                                             Command="{Binding ToggleAgentModelPickerCommand}"
                                             ButtonType="Default"
                                             MinWidth="130"/>
                                <atom:Button Grid.Column="2"
                                             Content="{Binding AgentRefreshModelsText}"
                                             Command="{Binding RefreshAgentModelsCommand}"
                                             ButtonType="Default"/>
                                <Popup IsOpen="{Binding IsAgentModelPickerOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=AgentModelPickerButton}"
                                       Placement="Bottom"
                                       IsLightDismissEnabled="True">
                                    <Border Classes="cx-popover"
                                            MinWidth="300"
                                            MaxWidth="480"
                                            MaxHeight="260"
                                            Padding="2">
                                        <ListBox ItemsSource="{Binding AgentModelOptions}"
                                                 SelectedItem="{Binding AgentModelOption, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MaxHeight="254">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,6">
                                                        <TextBlock Text="{Binding Content}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <TextBlock Grid.Row="4"
                                       Classes="cx-field-label"
                                       Text="{Binding AgentPlanKeyText}"/>
                            <atom:TextBox Grid.Row="4"
                                          Grid.Column="1"
                                          Text="{Binding AgentApiKey, Mode=TwoWay}"
                                          PasswordChar="*"
                                          IsEnableRevealButton="True"
                                          MinWidth="220"/>
                        </Grid>
                        <TextBlock Classes="cx-section-hint"
                                   Text="{Binding AgentPlanKeyDescriptionText}"
                                   Margin="142,0,0,0"/>
                        <TextBlock Classes="cx-section-hint"
                                   Text="{Binding AgentModelCatalogStatusText}"
                                   Margin="142,0,0,0"/>
                        <Grid ColumnDefinitions="132,Auto,Auto,*"
                              ColumnSpacing="10">
                            <TextBlock Classes="cx-field-label" Text="{Binding AgentRequestTimeoutText}"/>
                            <atom:NumericUpDown Grid.Column="1"
                                                Width="92"
                                                Minimum="5"
                                                Maximum="600"
                                                Value="{Binding AgentRequestTimeoutSeconds, Mode=TwoWay}"/>
                            <TextBlock Grid.Column="2"
                                       Classes="cx-field-label"
                                       Text="{Binding AgentSecondsText}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*">
                            <TextBlock Text="{Binding AgentStatusText}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"/>
                        </Grid>
                        <Border Classes="cx-card-quiet" Margin="0,4,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="cx-section-title" Text="{Binding AgentWebText}"/>
                                <atom:CheckBox Content="{Binding AgentWebEnabledText}"
                                               IsChecked="{Binding AgentWebEnabled, Mode=TwoWay}"/>
                                <Grid ColumnDefinitions="132,*"
                                      ColumnSpacing="10"
                                      IsEnabled="{Binding AgentWebEnabled}">
                                    <TextBlock Classes="cx-field-label" Text="{Binding AgentSearxngBaseUrlText}"/>
                                    <atom:TextBox Grid.Column="1"
                                                  Text="{Binding AgentSearxngBaseUrl, Mode=TwoWay}"
                                                  Watermark="https://searx.example"/>
                                </Grid>
                                <Grid ColumnDefinitions="132,*"
                                      ColumnSpacing="10"
                                      IsEnabled="{Binding AgentWebEnabled}">
                                    <TextBlock Classes="cx-field-label"
                                               Text="{Binding AgentAllowedPrivateHostsText}"
                                               VerticalAlignment="Top"
                                               Margin="0,6,0,0"/>
                                    <atom:TextBox Grid.Column="1"
                                                  Text="{Binding AgentAllowedPrivateHosts, Mode=TwoWay}"
                                                  AcceptsReturn="True"
                                                  TextWrapping="Wrap"
                                                  MinHeight="48"
                                                  Watermark="host.example.com:8080"/>
                                </Grid>
                                <atom:CheckBox Content="{Binding AgentAllowPrivateNetworkText}"
                                               IsChecked="{Binding AgentAllowPrivateNetwork, Mode=TwoWay}"
                                               IsEnabled="{Binding AgentWebEnabled}"/>
                                <Grid ColumnDefinitions="132,Auto,132,Auto"
                                      ColumnSpacing="10"
                                      IsEnabled="{Binding AgentWebEnabled}">
                                    <TextBlock Classes="cx-field-label" Text="{Binding AgentWebMaxResultsText}"/>
                                    <atom:NumericUpDown Grid.Column="1"
                                                        Width="76"
                                                        Minimum="1"
                                                        Maximum="20"
                                                        Value="{Binding AgentWebMaxResults, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2"
                                               Classes="cx-field-label"
                                               Text="{Binding AgentWebMaxFetchCharactersText}"/>
                                    <atom:NumericUpDown Grid.Column="3"
                                                        Width="92"
                                                        Minimum="2000"
                                                        Maximum="400000"
                                                        Value="{Binding AgentWebMaxFetchCharacters, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
